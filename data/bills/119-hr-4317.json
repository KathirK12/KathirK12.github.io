o":false,"label":"S. 3345","latest_action":{"date":"2025-12-04","text":"Read twice and referred to the Committee on Finance."},"policy_area":"Health","sponsor":{"chamber":"Senate","district":null,"id":"C000880","name":"Sen. Crapo, Mike","party":"R","state":"ID"},"stage":"in_committee","stage_label":"Referred to committee","summary":"The PBM Price Transparency and Accountability Act amends titles XVIII and XIX of the Social Security Act to regulate pharmacy benefit managers (PBMs) and improve pricing transparency in Medicare Part D and Medicaid. It requires transparent pass-through pricing models in Medicaid, prohibits certain forms of spread pricing, establishes pharmacy survey reporting requirements to determine actual acquisition costs, creates new accountability and reporting rules for PBMs operating in Medicare, ensures any willing pharmacy can join Medicare prescription drug plan networks under reasonable contract terms, and provides funding for government studies and oversight.","summary_threshold":50,"title":"PBM Price Transparency and Accountability Act","viability":27.1,"viability_status":"active"},"date":"2025-12-04","detail":"Related bill","id":"119-s-3345","label":"S. 3345","title":"PBM Price Transparency and Accountability Act","url":"https://www.congress.gov/bill/119th-congress/senate-bill/3345"},{"card":{"analysis_status":"excluded","bipartisan_band":"single","chamber":"Senate","cosponsor_count":1,"id":"119-s-891","importance":null,"importance_band":null,"introduced_date":"2025-03-06","is_demo":false,"label":"S. 891","latest_action":{"date":"2025-03-06","text":"Read twice and referred to the Committee on Finance."},"policy_area":"Health","sponsor":{"chamber":"Senate","district":null,"id":"W000779","name":"Sen. Wyden, Ron","party":"D","state":"OR"},"stage":"in_committee","stage_label":"Referred to committee","summary":null,"summary_threshold":50,"title":"Bipartisan Health Care Act","viability":11.6,"viability_status":"active"},"date":"2025-03-06","deta