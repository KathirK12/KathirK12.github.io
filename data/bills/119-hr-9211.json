3.7},{"day":"2026-10-26","importance":75,"viability":43.7}],"id":"119-hr-9211","importance":75,"importance_band":"substantial","importance_detail":{"consistent":true,"dimension_mean":75.0,"dimensions":[{"assessment":"Affects Jewish students, educational institutions receiving federal financial assistance, nonprofit organizations applying for security grants, state and local law enforcement agencies, and major online platforms with over 50 million monthly users.","evidence":"has at least 50,000,000 unique monthly users in the United States for a majority of the months in the most recent 12-month period.","evidence_verified":true,"key":"population","score":80},{"assessment":"Imposes extensive reporting, grievance procedures, and transparency requirements on schools and online platforms, alongside substantial grant funding authorization increases.","evidence":"Each recipient shall adopt, publish, and implement a title VI grievance procedure","evidence_verified":true,"key":"magnitude","score":70},{"assessment":"Increases authorizations of appropriations for the Nonprofit Security Grant Program to $1,000,000,000 for each of fiscal years 2027 through 2031, split evenly.","evidence":"$1,000,000,000 for each of fiscal years 2027 through 2031","evidence_verified":true,"key":"fiscal","score":80},{"assessment":"Amends multiple federal statutes including the Homeland Security Act of 2002, the Higher Education Act of 1965, the Civil Rights Act of 1964, and imposes Federal Trade Commission enforcement rules.","evidence":"A violation of this section or a regulation promulgated under this section shall be treated as a violation of a rule defining an unfair or deceptive act or practice","evidence_verified":true,"key":"scope","score":75},{"assessment":"Authorizes appropriations through fiscal year 2031 and mandates ongoing annual reports, threat assessments, and transparency submissions for multiple years.","evidence":"for each of fiscal years 2027 through 2031","evidence_verified":true,"key":"duration","score":70}],"missing_information":["The exact costs of establishing the Department of Education clearinghouse and conducting all required federal studies are not explicitly totaled.","Specific penalty amounts under FTC enforcement are not enumerated beyond referencing the Federal Trade Commission Act."],"rationale":"The Jewish American Security Act significantly increases authorization of appropriations for the Nonprofit Security Grant Program to $1 billion per year, establishes new Department of Education coordinator and training requirements, mandates FTC transparency reports for large online platforms, and requires joint annual threat assessments.","score":75},"importance_meta":{"generated_at":"2026-10-26T06:20:01+00:00","model":"gemini-3.5-flash-lite","source_basis":"text","source_urls":["https://www.congress.gov/119/bills/hr9211/BILLS-119hr9211ih.htm"]},"introduced_date":"2026-06-09","is_demo":false,"label":"H.R. 9211","latest_action":{"date":"2026-07-07","text":"Referred to the Subcommittee on Counterterrorism and Intelligence."},"members":[{"chamber":"House","district":"10","id":"G000599","name":"Rep. Goldman, Daniel S.","party":"D","role":"sponsor","state":"NY"},{"chamber":"House","date":"2026-06-09","district":"17","id":"L000599","name":"Rep. Lawler, Michael","original":true,"party":"R","role":"cosponsor","state":"NY"},{"chamber":"House","date":"2026-06-09","district":"25","id":"W000797","name":"Rep. Wasserman Schultz, Debbie","original":true,"party":"D","role":"cosponsor","state":"FL"},{"chamber":"House","date":"2026-06-09","district":"1","id":"F000466","name":"Rep. Fitzpatrick, Brian K.","original":true,"party":"R","role":"cosponsor","state":"PA"},{"chamber":"House","date":"2026-06-09","district":"23","id":"M001217","name":"Rep. Moskowitz, Jared","original":true,"party":"D","role":"cosponsor","state":"FL"},{"chamber":"House","date":"2026-06-09","district":"27","id":"S000168","name":"Rep. Salazar, Maria Elvira","original":true,"party"