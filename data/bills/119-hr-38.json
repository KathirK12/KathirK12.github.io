iginal":false,"party":"R","role":"cosponsor","state":"GA"},{"chamber":"House","date":"2025-06-26","district":"15","id":"C001126","name":"Rep. Carey, Mike","original":false,"party":"R","role":"cosponsor","state":"OH"},{"chamber":"House","date":"2025-07-14","district":"16","id":"K000376","name":"Rep. Kelly, Mike","original":false,"party":"R","role":"cosponsor","state":"PA"},{"chamber":"House","date":"2025-08-01","district":"10","id":"J000307","name":"Rep. James, John","original":false,"party":"R","role":"cosponsor","state":"MI"},{"chamber":"House","date":"2025-10-03","district":"1","id":"P000622","name":"Rep. Patronis, Jimmy","original":false,"party":"R","role":"cosponsor","state":"FL"}],"party_counts":{"D":1,"R":189},"perspectives":[],"policy_area":"Crime and Law Enforcement","related":{"companion":[],"related":[]},"selection":{"reason":"Impact scored and summarised by Gemini.","status":"analyzed"},"sources":{"latest":{"date":"2025-10-03","label":"Reported in House","url":"https://www.congress.gov/119/bills/hr38/BILLS-119hr38rh.htm"},"other":[{"label":"This bill on Congress.gov","url":"https://www.congress.gov/bill/119th-congress/house-bill/38"}],"past":[{"date":"2025-01-03","label":"Introduced in House","url":"https://www.congress.gov/119/bills/hr38/BILLS-119hr38ih.htm"}]},"sponsor":{"chamber":"House","district":"9","id":"H001067","name":"Rep. Hudson, Richard","party":"R","state":"NC"},"stage":"on_calendar","stage_label":"On a chamber calendar","summary":"The Constitutional Concealed Carry Reciprocity Act of 2025 creates a federal framework allowing individuals who are legally permitted to carry a concealed firearm in their home state to also carry a concealed handgun in other states that allow their own residents to carry concealed firearms. It overrides conflicting state and local laws, sets out rules for law enforcement interactions, and creates a private right of action for individuals whose rights under the bill are violated.","summary_detail":{"affected_groups":[{"effect":"Can carry concealed handguns in other states that allow concealed carry for their own residents, and gain protections from arrest unless probable cause is established.","group":"Concealed firearm permit holders and eligible residents"},{"effect":"Must recognize out-of-state concealed carry permits that meet federal criteria, have state and local laws preempted by the federal framework, and face potential lawsuits and attorney fee awards if they interfere with rights established by the bill.","group":"State and local governments"},{"effect":"Retain the ability to prohibit or restrict the possession of concealed firearms on their properties.","group":"Private property and business owners"}],"key_provisions":["Allows individuals eligible to carry a concealed firearm in one state to carry a concealed handgun in any other state that issues concealed carry permits or does not prohibit residents from carrying concealed firearms for lawful purposes.","Excludes machine guns and destructive devices from the types of handguns permitted under this reciprocity.","Requires the carrier to have a valid photo identification document and a valid permit or license from their home state.","Permits individuals to carry concealed handguns in specific public federal lands open to the public, including National Parks, Wildlife Refuges, and Bureau of Land Management lands.","Protects private property owners and government entities from having their rules superseded if they choose to prohibit concealed firearms on their properties or government installations.","Establishes that presenting facially valid documents serves as prima facie evidence of a valid permit during law enforcement stops, and places the burden of proof on the prosecution beyond a reasonable doubt in criminal proceedings.","Creates a civil right of action allowing individuals deprived of rights under this bill to sue states or local governments for damages and attorney's fees."],"missing_information":["The specific number of individuals nationwide who hold concealed carry permits or would be newly eligible to cross state lines with a handgun.","Exact fiscal impacts or administrative costs to federal, state, and local court systems."],"plain_summary":"The Constitutional Concealed Carry Reciprocity Act of 2025 creates a federal framework allowing individuals who are legally permitted to carry a concealed firearm in their home state to also carry a concealed handgun in other states that allow their own residents to carry concealed firearms. It overrides conflicting state and local laws, sets out rules for law enforcement interactions, and creates a private right of action for individuals whose rights under the bill are violated.","significance":"The bill establishes a nationwide standard for recognizing out-of-state concealed carry permits, altering how state and local firearm laws apply to nonresidents. It impacts individuals traveling across state lines with firearms, law enforcement procedures during stops, and the authority of state and local governments to enforce their own concealed carry restrictions."},"summary_meta":{"generated_at":"2026-10-27T13:10:59+00:00","model":"gemini-3.5-flash-lite","source_basis":"text+summary","source_urls":["https://www.congress.gov/119/bills/hr38/BILLS-119hr38rh.htm"]},"summary_threshold":50,"title":"Constitutional Concealed Carry Reciprocity Act of 2025","viability":53.9,"viability_detail":{"breakdown":[{"available":true,"effective_weight":35.0,"inputs":[{"label":"Detected stage","value":"On a chamber calendar"}],"key":"stage","label":"Legislative stage","note":"Stage value from the table on the About page.","points":22.75,"value":0.65,"weight":35},{"available":true,"effective_weight":15.0,"inputs":[{"label":"Committee activity","value":"Reported out of committee (or past committee stage)"}],"key":"committee","label":"Committee activity","note":"","points":15.0,"value":1.0,"weight":15},{"available":true,"effective_weight":15.0,"inputs"