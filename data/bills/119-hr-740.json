":"House","date":"2026-04-28","district":"5","id":"O000175","name":"Rep. Ogles, Andrew","original":false,"party":"R","role":"cosponsor","state":"TN"},{"chamber":"House","date":"2026-05-12","district":"5","id":"W000798","name":"Rep. Walberg, Tim","original":false,"party":"R","role":"cosponsor","state":"MI"},{"chamber":"House","date":"2026-05-19","district":"7","id":"M001230","name":"Rep. Mackenzie, Ryan","original":false,"party":"R","role":"cosponsor","state":"PA"},{"chamber":"House","date":"2026-06-11","district":"6","id":"R000612","name":"Rep. Rose, John W.","original":false,"party":"R","role":"cosponsor","state":"TN"}],"party_counts":{"D":2,"R":89},"perspectives":[],"policy_area":"Armed Forces and National Security","related":{"companion":[],"related":[{"card":{"analysis_status":"analyzed","bipartisan_band":"single","chamber":"Senate","cosponsor_count":15,"id":"119-s-275","importance":70,"importance_band":"substantial","introduced_date":"2025-01-28","is_demo":false,"label":"S. 275","latest_action":{"date":"2025-07-30","text":"Committee on Veterans' Affairs. Ordered to be reported with an amendment in the nature of a substitute favorably."},"policy_area":"Armed Forces and National Security","sponsor":{"chamber":"Senate","district":null,"id":"M000934","name":"Sen. Moran, Jerry","party":"R","state":"KS"},"stage":"reported","stage_label":"Reported by committee","summary":"The Veterans’ Assuring Critical Care Expansions to Support Servicemembers (ACCESS) Act of 2025 modifies the Department of Veterans Affairs (VA) health care programs, focusing primarily on the Veterans Community Care Program (VCCP) and mental health residential treatment programs. The bill codifies access standards for non-VA care, introduces strict timelines for notification and appointment processing, establishes standardized screening and placement procedures for mental health and substance abuse treatment, and mandates new online tools, pilot programs, and reporting requirements.","summary_threshold":50,"title":"Veterans’ Assuring Critical Care Expansions to Support Servicemembers (ACCESS) Act of 2025","viability":41.9,"viability_status":"active"},"date":"2025-07-30","detail":"Related bill","id":"119-s-275","label":"S. 275","title":"Veterans’ Assuring Critical Care Expansions to Support Servicemembers (ACCESS) Act of 2025","url":"https://www.congress.gov/bill/119th-congress/senate-bill/275"}]},"selection":{"reason":"Impact scored and summarised by Gemini.","status":"analyzed"},"sources":{"latest":{"date":"2025-01-28","label":"Introduced in House","url":"https://www.congress.gov/119/bills/hr740/BILLS-119hr740ih.htm"},"other":[{"label":"This bill on Congress.gov","url":"https://www.congress.gov/bill/119th-congress/house-bill/740"},{"label":"CBO cost estimate: H.R. 740, Veterans’ Assuring Critical Care Expansions to Support Servicemembers Act of 2025","url":"https://www.cbo.gov/publication/61785"}],"past":[]},"sponsor":{"chamber":"House","district":"12","id":"B001295","name":"Rep. Bost, Mike","party":"R","state":"IL"},"stage":"committee_action","stage_label":"Committee hearing or markup","summary":"The Veterans’ ACCESS Act of 2025 makes various changes to the administration of the Department of Veterans Affairs (VA) health care system, specifically focusing on the Veterans Community Care Program, mental health residential treatment programs, and online self-service tools.","summary_detail":{"affected_groups":[{"effect":"Veterans experience modified wait-time and drive-time standards for community care eligibility, clearer notifications regarding care and denials, enhanced mental health screening and residential treatment access, and new self-service appointment and referral tracking tools.","group":"Veterans"},{"effect":"VA staff must adhere to new standardized mental health screening processes, performance tracking metrics, updated training timelines, and specific notification windows for veteran eligibility and care denials.","group":"VA Health Care Personnel"},{"effect":"Providers participating in the Veterans Community Care Program receive an extended one-year deadline to submit claims under prompt payment standards and must coordinate care and share records with the VA.","group":"Health Care Providers and Entities"}],"key_provisions":["Codifies in statute access standards for the Veterans Community Care Program based on drive time and wait time for primary, specialty, and mental health care.","Requires the VA to notify veterans in writing within two business days when they become eligible for community care or when a community care request is denied.","Establishes a standardized screening process for priority or routine admission to mental health residential rehabilitation treatment programs and substance abuse programs.","Creates a national clinical appeal policy and procedure for veterans denied admission to mental health residential treatment programs or not offered timely bed placement.","Extends the deadline for health care entities and providers to submit claims under the prompt payment standard of the Veterans Community Care Program from 180 days to one year.","Establishes a three-year pilot program allowing enrolled veterans to access outpatient mental health and substance use services through specified community providers without prior referral or pre-authorization."],"missing_information":["Total estimated cost or appropriations required to implement the bill's provisions.","Exact start dates for the pilot programs and reporting mandates beyond relative timeframes specified in the text."],"plain_summary":"The Veterans’ ACCESS Act of 2025 makes various changes to the administration of the Department of Veterans Affairs (VA) health care system, specifically focusing on the Veterans Community Care Program, mental health residential treatment programs, and online self-service tools.","significance":"The bill alters administrative requirements, deadlines, and oversight mechanisms across multiple VA health care programs, impacting how veterans access community care and specialized mental health treatment."},"summary_meta":{"generated_at":"2026-10-26T07:55:12+00:00","model":"gemini-3.5-flash-lite","source_basis":"text+summary","source_urls":["https://www.congress.gov/119/bills/hr740/BILLS-119hr740ih.htm"]},"summary_threshold":50,"title":"Veterans’ ACCESS Act of 2025","viability":33.1,"viability_detail":{"breakdown":[{"available":true,"effective_weight":35.0,"inputs":[{"label":"Detected stage","value":"Committee hearing or markup"}],"key":"stage","label":"Legislative stage","note":"Stage value from the table on the About page.","points":14.0,"value":0.4,"weight":35},{"available":true,"effective_weight":15.0,"inputs":[{"label":"Committee activity","value":"Markup / ordered reported"}],"key":"committee","label":"Committee activity","note":"","points":12.0,"value":0.8,"weight":15},{"available":true,"effective_weight":15.0,"inputs":[{"label":"Floor activity","value":"No floor activity"}],"key":"floor","label":"Floor consideration","note":"","points":0.0,"value":0.0,"weight":15},{"available":true,"effective_weight":15.0,"inputs":[{"label":"Days since latest action","value":460},{"label":"Half-life (days)","value":90}],"key":"momentum","label":"Recent action","note":"","points":0.43,"value":0.0289,"weight":15},{"available":true,"effective_weight":10.0,"inputs":[{"label":"Cosponsors","value":88},{"label":"House majority","value":218}],"key":"cosponsors","label":"Cosponsorship","note":"","points":6.35,"value":0.6354,"weight":10},{"available":true,"effective_weight":10.0,"inputs":[{"label":"Democratic supporters","value":2},{"label":"Republican supporters","value":89}],"key":"bipartisan","label":"Bipartisan support","note":"Sponsor plus cosponsors; independents are not counted toward either party.","points":0.29,"value":0.0293,"weight":10}],"data_completeness":1.0,"formula_version":"1.1","reached_stage":"committee_action","score":33.1,"stage":"committee_action","status":"active"},"via