ortance":null,"importance_band":null,"introduced_date":"2026-05-13","is_demo":false,"label":"S. 4518","latest_action":{"date":"2026-05-13","text":"Read twice and referred to the Committee on Agriculture, Nutrition, and Forestry."},"policy_area":"Agriculture and Food","sponsor":{"chamber":"Senate","district":null,"id":"S000033","name":"Sen. Sanders, Bernard","party":"I","state":"VT"},"stage":"in_committee","stage_label":"Referred to committee","summary":null,"summary_threshold":50,"title":"Universal School Meals Program Act of 2026","viability":20.3,"viability_status":"active"},"date":"2026-05-13","detail":"Identical bill","id":"119-s-4518","label":"S. 4518","title":"Universal School Meals Program Act of 2026","url":"https://www.congress.gov/bill/119th-congress/senate-bill/4518"}],"related":[{"card":{"analysis_status":"analyzed","bipartisan_band":"single","chamber":"House","cosponsor_count":16,"id":"119-hr-10421","importance":90,"importance_band":"sweeping","introduced_date":"2026-09-16","is_demo":false,"label":"H.R. 10421","latest_action":{"date":"2026-09-16","text":"Referred to the Committee on Education and Workforce, and in addition to the Committees on the Judiciary, Energy and Commerce, Ways and Means, Oversight and Government Reform, Science, Space, and Technology, Armed Services, and Agriculture, for a period to be subsequently determined by the Speaker, in each case for consideration of such provisions as fall within the jurisdiction of the committee concerned."},"policy_area":"Education","sponsor":{"chamber":"House","district":"1","id":"B001278","name":"Rep. Bonamici, Suzanne","party":"D","state":"OR"},"stage":"in_committee","stage_label":"Referred to committee","summary":"H.R. 10421, titled the \"Transforming Education for the Future Act,\" amends the Elementary and Secondary Education Act of 1965 and other laws to increase federal support for elementary and secondary education. The bill provides increased funding and new programs across several areas, including well-rounded education initiatives like arts and history, school climate and safety measures such as banning corporal punishment and seclusion, support for educators and school staff salaries and mental health, and programs addressing socioeconomic barriers like universal preschool and universal school meals.","summary_threshold":50,"title":"Transforming Education for the Future Act","viability":34.3,"viability_status":"active"},"date":"2026-09-16","detail":"Related bill","id":"119-hr-10421","label":"H.R. 10421","title":"Transforming Education for the Future Act","url":"https://www.congress.gov/bill/119th-congress/house-bill/10421"}]},"selection":{"reason":"Impact scored and summarised by Gemini. (rated before the current eligibility rules; kept)","status":"analyzed"},"sources":{"latest":{"date":"2026-05-13","label":"Introduced in House","url":"https://www.congress.gov/119/bills/hr8798/BILLS-119hr8798ih.htm"},"other":[{"label":"This bill on Congress.gov","url":"https://www.congress.gov/bill/119th-congress/house-bill/8798"}],"past":[]},"sponsor":{"chamber":"House","district":"5","id":"O000173","name":"Rep. Omar, Ilhan","party":"D","state":"MN"},"stage":"in_committee","stage_label":"Referred to committee","summary":"The Universal School Meals Program Act of 2026 amends the Child Nutrition Act of 1966 and the Richard B. Russell National School Lunch Act to provide free breakfasts and lunches to all children enrolled in participating schools, regardless of family income. It also establishes programs to reimburse schools for delinquent student meal debt, prohibits practices like meal shaming, provides additional reimbursements for using locally-sourced farm products, and adjusts poverty measurement criteria across various education and nutrition programs.","summary_detail":{"affected_groups":[{"effect":"Receive free breakfasts and lunches at participating schools without having to meet income eligibility tests, and are protected from meal shaming or segregation due to unpaid meal charges.","group":"School children"},{"effect":"Prohibited from collecting past or current meal debt, become eligible for federal reimbursement of delinquent debt, and receive specific national average payment rates for free meals.","group":"Schools and school food authorities"},{"effect":"May benefit from increased school purchases due to additional reimbursement incentives for using locally-sourced farm products.","group":"Local agricultural producers"}],"key_provisions":["Makes breakfasts and lunches free for all children at participating schools.","Prohibits schools from collecting unpaid meal debt and establishes a reimbursement program for schools to cover all delinquent student meal debt.","Bans schools and food authorities from physically segregating, debt shaming, or overtly identifying children participating in the breakfast program.","Provides additional meal reimbursement payments to school food authorities that serve meals containing at least 25 percent locally-sourced farm products.","Updates summer food service and summer electronic benefit transfer programs to make all children eligible and modifies various child care and afterschool meal programs.","Replaces free or reduced-price lunch eligibility metrics with low-income background measures under the Elementary and Secondary Education Act of 1965."],"missing_information":["Total cost of the legislation and specific federal appropriations required.","Exact number of schools and children nationwide that would participate.","Long-term economic impact on state and federal budgets."],"plain_summary":"The Universal School Meals Program Act of 2026 amends the Child Nutrition Act of 1966 and the Richard B. Russell National School Lunch Act to provide free breakfasts and lunches to all children enrolled in participating schools, regardless of family income. It also establishes programs to reimburse schools for delinquent student meal debt, prohibits practices like meal shaming, provides additional reimbursements for using locally-sourced farm products, and adjusts poverty measurement criteria across various education and nutrition programs.","significance":"This bill significantly alters federal child nutrition programs by shifting from income-based free and reduced-price meals to a universal free meal system for all students, while also addressing past meal debt and modifying related educational data collection methods across multiple federal statutes."},"summary_meta":{"generated_at":"2026-11-04T22:53:59+00:00","model":"gemini-3.5-flash-lite","source_basis":"text","source_urls":["https://www.congress.gov/119/bills/hr8798/BILLS-119hr8798ih.htm"]},"summary_threshold":50,"title":"Universal School Meals Program Act of 2026","viability":31.6,"viability_detail":{"breakdown":[{"available":true,"effective_weight":35.0,"inputs":[{"label":"Detected stage","value":"Referred to committee"}],"key":"stage","label":"Legislative stage","note":"Stage value from the table on the About page.","points":7.0,"value":0.2,"weight":35},{"available":true,"effective_weight":15.0,"inputs":[{"label":"Committee activity","value":"Referred to committee"}],"key":"committee","label":"Committee activity","note":"","points":3.0,"value":0.2,"weight":15},{"available":true,"effective_weight":15.0,"inputs":[{"label":"Floor activity","value":"Considered on the floor (rule, motion, cloture, vote)"}],"key":"floor","label":"Floor consideration","note":"","points":10.5,"value":0.7,"weight":15},{"available":true,"effective_weight":15.0,"inputs":[{"label":"Days since latest action","value":165},{"label":"Half-life (days)","value":90}],"key":"momentum","label":"Recent action","note":"","points":4.21,"value":0.2806,"weight":15},{"available":true,"effective_weight":10.0,"inputs":[{"label":"Cosponsors","value":103},{"label":"House majority","value":218}],"key":"cosponsors","label":"Cosponsorship","note":"","points":6.87,"value":0.6874,"weight":10},{"available":true,"effective_weight":10.0,"inputs":[