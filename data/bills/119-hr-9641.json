ber":"House","date":"2026-10-22","district":"5","id":"R000609","name":"Rep. Rutherford, John H.","original":false,"party":"R","role":"cosponsor","state":"FL"},{"chamber":"House","date":"2026-10-22","district":"11","id":"M000317","name":"Rep. Malliotakis, Nicole","original":false,"party":"R","role":"cosponsor","state":"NY"},{"chamber":"House","date":"2026-10-22","district":"5","id":"G000583","name":"Rep. Gottheimer, Josh","original":false,"party":"D","role":"cosponsor","state":"NJ"}],"party_counts":{"D":45,"R":43},"perspectives":[],"policy_area":"Health","related":{"companion":[],"related":[]},"selection":{"reason":"Impact scored and summarised by Gemini.","status":"analyzed"},"sources":{"latest":{"date":"2026-07-13","label":"Introduced in House","url":"https://www.congress.gov/119/bills/hr9641/BILLS-119hr9641ih.htm"},"other":[{"label":"This bill on Congress.gov","url":"https://www.congress.gov/bill/119th-congress/house-bill/9641"},{"label":"CBO cost estimate: H.R. 9641, Essential Caregivers Act","url":"https://www.cbo.gov/publication/62708"}],"past":[]},"sponsor":{"chamber":"House","district":"24","id":"T000478","name":"Rep. Tenney, Claudia","party":"R","state":"NY"},"stage":"committee_action","stage_label":"Committee hearing or markup","summary":"The Essential Caregivers Act of 2026 requires certain nursing homes and long-term care facilities to implement an essential caregivers program during times when regular visitation is suspended. The bill ensures that residents can designate up to two essential caregivers who are permitted in-person access under specific safety protocols.","summary_detail":{"affected_groups":[{"effect":"Able to elect two essential caregivers who can visit during periods when regular visitation is suspended, with guaranteed access during end-of-life care.","group":"Facility Residents"},{"effect":"Granted in-person access to residents during visitation suspensions, provided they agree to follow facility safety protocols.","group":"Essential Caregivers"},{"effect":"Required to implement essential caregivers programs, follow specific limitation rules, and comply with priority complaint investigations.","group":"Nursing and Long-Term Care Facilities"}],"key_provisions":["Requires Medicare skilled nursing facilities, long-term care hospitals, inpatient rehabilitation facilities, Medicaid nursing facilities, and intermediate care facilities for individuals with intellectual disabilities to maintain an essential caregivers program during suspended regular visitation periods.","Allows each resident to elect two essential caregivers and change that election at any time, with representatives able to choose for residents unable to do so due to cognitive decline or mental disability.","Permits facilities to limit access for the first 7 days of a visitation suspension if audio-visual telecommunications access is provided, or if a caregiver shows symptoms of a serious infectious disease or fails to follow safety protocols.","Prohibits facilities from denying or limiting essential caregiver access during end-of-life care.","Requires safety and infection control protocols for essential caregivers to be in writing and no more restrictive than protocols applicable to facility staff.","Requires state survey and certification agencies to prioritize complaints regarding essential caregiver access and notify complainants within 3 days."],"missing_information":["The total number of facilities or individuals that would be affected nationwide.","Any financial costs or funding details associated with implementing the program and handling prioritized complaints."],"plain_summary":"The Essential Caregivers Act of 2026 requires certain nursing homes and long-term care facilities to implement an essential caregivers program during times when regular visitation is suspended. The bill ensures that residents can designate up to two essential caregivers who are permitted in-person access under specific safety protocols.","significance":"The bill mandates federal standards for caregiver access across multiple types of federally funded care facilities during restricted visitation periods, altering how facilities handle visitor restrictions and complaint investigations."},"summary_meta":{"generated_at":"2026-10-27T13:31:51+00:00","model":"gemini-3.5-flash-lite","source_basis":"text+summary","source_urls":["https://www.congress.gov/119/bills/hr9641/BILLS-119hr9641ih.htm"]},"summary_threshold":50,"title":"Essential Caregivers Act of 2026","viability":59.4,"viability_detail":{"breakdown":[{"available":true,"effective_weight":35.0,"inputs":[{"label":"Detected stage","value":"Committee hearing or markup"}],"key":"stage","label":"Legislative stage","note":"Stage value from the table on the About page.","points":14.0,"value":0.4,"weight":35},{"available":true,"effective_weight":15.0,"inputs":[{"label":"Committee activity","value":"Markup / ordered reported"}],"key":"committee","label":"Committee activity","note":"","points":12.0,"value":0.8,"weight":15},{"available":true,"effective_weight":15.0,"inputs":[{"label":"Floor activity","value":"Considered on the floor (rule, motion, cloture, vote)"}],"key":"floor","label":"Floor consideration","note":"","points":10.5,"value":0.7,"weight":15},{"available":true,"effective_weight":15.0,"inputs":[{"label":"Days since latest action","value":103},{"label":"Half-life (days)","value":90}],"key":"momentum","label":"Recent action","note":"","points":6.79,"value":0.4524,"weight":15},{"available":true,"effective_weight":10.0,"inputs":[{"label":"Cosponsors","value":87},{"label":"House majority","value":218}],"key":"cosponsors","label":"Cosponsorship","note":"","points":6.32,"value":0.6317,"weight":10},{"available":true,"effective_weight":10.0,"inputs":[{"label":"Democratic supporters","value":45},{"label":"Republican supporters","value":43}],"key":"bipartisan","label":"Bipartisan support","note":"Sponsor plus cosponsors; independents are not counted toward either party.","poi