:"J000312","name":"Sen. Justice, James C.","original":false,"party":"R","role":"cosponsor","state":"WV"},{"chamber":"Senate","date":"2026-06-02","district":null,"id":"M001243","name":"Sen. McCormick, David","original":false,"party":"R","role":"cosponsor","state":"PA"}],"party_counts":{"D":33,"I":1,"R":43},"perspectives":[],"policy_area":"Science, Technology, Communications","related":{"companion":[],"related":[]},"selection":{"reason":"Impact scored and summarised by Gemini.","status":"analyzed"},"sources":{"latest":{"date":"2025-05-14","label":"Introduced in Senate","url":"https://www.congress.gov/119/bills/s1748/BILLS-119s1748is.htm"},"other":[{"label":"This bill on Congress.gov","url":"https://www.congress.gov/bill/119th-congress/senate-bill/1748"}],"past":[]},"sponsor":{"chamber":"Senate","district":null,"id":"B001243","name":"Sen. Blackburn, Marsha","party":"R","state":"TN"},"stage":"reported","stage_label":"Reported by committee","summary":"The Kids Online Safety Act establishes safety, privacy, and transparency rules for online platforms, social media, video games, messaging apps, and video streaming services that are used by minors under 17. The bill requires covered platforms to use reasonable care to prevent specific harms to minors, provide protective default settings and parental controls, prohibit market research on children under 13, and allow all users to switch to an algorithm that does not rely on user-specific data.","summary_detail":{"affected_groups":[{"effect":"Receive protective default settings, limits on compulsive design features, content recommendation controls, prohibitions on targeted illegal product advertising, and restricted market research.","group":"Minors under 17 years old"},{"effect":"Receive maximum default privacy settings, mandatory parental management controls by default, and a complete ban on platform market and product-focused research.","group":"Children under 13 years old"},{"effect":"Gain access to parental tools to view and change minor account settings, monitor time spent, restrict financial transactions, and receive notices regarding their child's account.","group":"Parents and legal guardians"},{"effect":"Must alter platform design and safety features, implement parental controls and reporting mechanisms, conduct third-party audits and public reporting if large, and provide algorithmic transparency and user choice.","group":"Online platforms and social media companies"}],"key_provisions":["Requires covered platforms to exercise reasonable care in designing features to prevent and mitigate harms to minors, such as mental health disorders, severe harassment, and sexual exploitation.","Mandates that platforms provide minors with easy-to-use safeguards regarding communication limits, privacy restrictions, geolocation tracking limits, and time-spent controls, with the most protective settings enabled by default.","Requires platforms to provide parents with tools to manage a minor's privacy and account settings, restrict financial transactions, and view or limit total time spent on the platform.","Prohibits platforms from conducting market or product research on children under 13, and requires verifiable parental consent for such research on minors aged 13 to 16.","Prohibits the advertising of narcotic drugs, cannabis, tobacco products, gambling, and alcohol to minors.","Requires large online platforms with over 10 million monthly active U.S. users to undergo independent annual audits and publish public transparency reports regarding minor usage and platform safeguards.","Requires online platforms that use opaque algorithms based on user-specific data to notify users and provide an easy option to switch to an input-transparent algorithm without changing service prices."],"missing_information":["Specific financial costs to the federal government or private entities for compliance and enforcement.","Exact technical standards or methods for age verification, which are deferred to a study conducted by the Secretary of Commerce, the FCC, and the FTC."],"plain_summary":"The Kids Online Safety Act establishes safety, privacy, and transparency rules for online platforms, social media, video games, messaging apps, and video streaming services that are used by minors under 17. The bill requires covered platforms to use reasonable care to prevent specific harms to minors, provide protective default settings and parental controls, prohibit market research on children under 13, and allow all users to switch to an algorithm that does not rely on user-specific data.","significance":"The legislation introduces broad regulatory requirements for digital platforms regarding minor safety, parental involvement, and algorithmic transparency, enforceable by the Federal Trade Commission and state attorneys general."},"summary_meta":{"generated_at":"2026-10-27T12:58:30+00:00","model":"gemini-3.5-flash-lite","source_basis":"text+summary","source_urls":["https://www.congress.gov/119/bills/s1748/BILLS-119s1748is.htm"]},"summary_threshold":50,"title":"Kids Online Safety Act","viability":62.7,"viability_detail":{"breakdown":[{"available":true,"effective_weight":35.0,"inputs":[{"label":"Detected stage","value":"Reported by committee"}],"key":"stage","label":"Legislative stage","note":"Stage value from the table on the About page.","points":21.0,"value":0.6,"weight":35},{"available":true,"effective_weight":15.0,"inputs":[{"label":"Committee activity","value":"Reported out of committee (or past committee stage)"}],"key":"committee","label":"Committee activity","note":"","points":15.0,"value":1.0,"weight":15},{"available":true,"effective_weight":15.0,"inputs":[{"label":"Floor activity","value":"No floor activity"}],"key":"floor","label":"Floor consideration","note":"","points":0.0,"value":0.0,"weight":15},{"available":true,"effective_weight":15.0,"inputs":[{"label":"Days since latest action","value":82},{"label":"Half-life (days)","value":90}],"key":"momentum","label":"Recent action","note":"","points":7.98,"value":0.5318,"weight":15},{"available":true,"effective_weight":10.0,"inputs":[{"label":"Cosponsors","value":76},{"label":"Senate majority","value":51}],"key":"cosponsors","label":"Cosponsorship","note":"","points":10.0,"value":1.0,"weight":10},{"available":true,"effective_weight":10.0,"inputs":[{"label":"Democratic supporters","value":33},{"label":"Republican supporters","value":43}],"key":"bipartisan","label":"Bipartisan support","note":"Sponsor plus cosponsors; independents are not counted toward either party.","points":8.68,"value":0.8684,"weight":10}],"data_completeness":1.0,"formula_version":"1.1","reached_stage":"reported","score":62.7,"stage":"reported","status":"active"},"viability_status":"active","votes":[]}