ey":"magnitude","score":80},{"assessment":"Establishes federal studies, advisory councils, and enforcement mechanisms through the FTC and state authorities, incurring administrative and compliance costs.","evidence":"A violation of this title shall be treated as a violation of a rule defining an unfair or deceptive act or practice","evidence_verified":true,"key":"fiscal","score":50},{"assessment":"Creates sweeping new regulatory frameworks, duties of care, default safety controls, market research restrictions, and algorithmic transparency mandates.","evidence":"it shall be unlawful for any person to operate an online platform that uses an opaque algorithm unless the person complies with the requirements","evidence_verified":true,"key":"scope","score":85},{"assessment":"Permanent federal regulatory framework governing online platforms and child safety.","evidence":null,"evidence_verified":false,"key":"duration","score":90}],"missing_information":["Specific federal budget appropriations for implementing the FTC enforcement and advisory council activities."],"rationale":"The bill implements nationwide safety standards, parental controls, transparency reports, and algorithmic limitations for online platforms used by minors, enforced by the FTC and state attorneys general.","score":85},"importance_meta":{"generated_at":"2026-10-27T12:56:53+00:00","model":"gemini-3.5-flash-lite","source_basis":"text+summary","source_urls":["https://www.congress.gov/119/bills/s1748/BILLS-119s1748is.htm"]},"introduced_date":"2025-05-14","is_demo":false,"label":"S. 1748","latest_action":{"date":"2026-08-05","text":"Committee on Commerce, Science, and Transportation. Ordered to be reported with an amendment in the nature of a substitute favorably."},"members":[{"chamber":"Senate","district":null,"id":"B001243","name":"Sen. Blackburn, Marsha","party":"R","role":"sponsor","state":"TN"},{"chamber":"Senate","date":"2025-05-14","district":null,"id":"B001277","name":"Sen. Blumenthal, Richard","orig