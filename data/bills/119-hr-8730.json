":"CA"},{"chamber":"House","date":"2026-10-22","district":"6","id":"C001133","name":"Rep. Ciscomani, Juan","original":false,"party":"R","role":"cosponsor","state":"AZ"}],"party_counts":{"D":65,"R":80},"perspectives":[],"policy_area":"Foreign Trade and International Finance","related":{"companion":[{"card":{"analysis_status":"analyzed","bipartisan_band":"strong","chamber":"Senate","cosponsor_count":57,"id":"119-s-4429","importance":75,"importance_band":"substantial","introduced_date":"2026-04-29","is_demo":false,"label":"S. 4429","latest_action":{"date":"2026-09-22","text":"Placed on Senate Legislative Calendar under General Orders. Calendar No. 671."},"policy_area":"Foreign Trade and International Finance","sponsor":{"chamber":"Senate","district":null,"id":"M001242","name":"Sen. Moreno, Bernie","party":"R","state":"OH"},"stage":"on_calendar","stage_label":"On a chamber calendar","summary":"The Connected Vehicle Security Act of 2026 aims to protect U.S. economic and national security by prohibiting the importation, manufacture, sale, resale, or introduction into interstate commerce of connected vehicles, related software, and hardware associated with specific foreign adversaries: China, Russia, Iran, and North Korea. The bill expands existing Department of Commerce regulations by adding new countries, incorporating artificial intelligence components, setting timelines for bans on software and hardware, providing authorization and advisory opinion procedures, requiring declarations of conformity, and imposing strict civil penalties for violations.","summary_threshold":50,"title":"Connected Vehicle Security Act of 2026","viability":72.5,"viability_status":"active"},"date":"2026-09-22","detail":"Identical bill","id":"119-s-4429","label":"S. 4429","title":"Connected Vehicle Security Act of 2026","url":"https://www.congress.gov/bill/119th-congress/senate-bill/4429"}],"related":[]},"selection":{"reason":"Impact scored and summarised by Gemini.","status":"analyzed"},"sources":{"latest":{"date":"2026-05-11","label":"Introduced in House","url":"https://www.congress.gov/119/bills/hr8730/BILLS-119hr8730ih.htm"},"other":[{"label":"This bill on Congress.gov","url":"https://www.congress.gov/bill/119th-congress/house-bill/8730"}],"past":[]},"sponsor":{"chamber":"House","district":"2","id":"M001194","name":"Rep. Moolenaar, John R.","party":"R","state":"MI"},"stage":"in_committee","stage_label":"Referred to committee","summary":"The Connected Vehicle Security Act of 2026 prohibits importing, manufacturing, selling, reselling, or introducing into U.S. interstate commerce certain connected vehicles, software, and hardware associated with specific foreign adversary countries: China, Russia, Iran, and North Korea. The legislation expands existing Department of Commerce regulations by adding new countries, incorporating artificial intelligence components, and setting explicit timelines, authorization procedures, and civil penalties for violations.","summary_detail":{"affected_groups":[{"effect":"Must comply with prohibitions on sourcing connected vehicles, software, and hardware from China, Russia, Iran, and North Korea, and must submit declarations of conformity or seek specific authorizations.","group":"Automotive manufacturers and suppliers"},{"effect":"May face restrictions on the availability of certain connected vehicle models or features associated with covered countries, though exemptions exist for vehicle hardware used for repairs and warranties on pre-2030 models.","group":"Consumers and vehicle owners"},{"effect":"Tasked with expanding regulatory frameworks, publishing authorized item lists, issuing binding rulings, assessing civil penalties, and submitting annual reports to Congress.","group":"Department of Commerce"}],"key_provisions":["Prohibits the importation, manufacture, sale, resale, or introduction into interstate commerce of connected vehicles originating from, designed within, or manufactured by entities controlled in China, Russia, Iran, or North Korea starting January 1, 2027.","Prohibits the integration of covered software originating from or developed by entities in covered countries into connected vehicles starting January 1, 2027.","Prohibits the importation, manufacture, sale, resale, or introduction into interstate commerce of connected vehicle hardware originating from or manufactured by entities in covered countries starting January 1, 2030, with exemptions for repair and warranty of pre-2030 vehicles.","Directs the Department of Commerce to establish a process for issuing general or specific authorizations, binding rulings, advisory opinions, and declarations of conformity.","Establishes civil penalties for violations of prohibitions, requiring fines of at least $1,500,000 or five times the value of the transaction per violation, with each day counting as a separate violation.","Requires the Secretary of Commerce to submit annual reports to Congress regarding enforcement activities, compliance rates, penalties, and assessments of effectiveness."],"missing_information":["Exact overall fiscal cost for implementing and enforcing the new regulatory framework.","Specific staffing levels or resource allocations for the Bureau of Industry and Security to handle increased rulings, authorizations, and penalties."],"plain_summary":"The Connected Vehicle Security Act of 2026 prohibits importing, manufacturing, selling, reselling, or introducing into U.S. interstate commerce certain connected vehicles, software, and hardware associated with specific foreign adversary countries: China, Russia, Iran, and North Korea. The legislation expands existing Department of Commerce regulations by adding new countries, incorporating artificial intelligence components, and setting explicit timelines, authorization procedures, and civil penalties for violations.","significance":"The bill aims to protect U.S. economic and national security by preventing foreign adversaries from accessing sensitive data, conducting surveillance, or disrupting critical infrastructure through connected vehicle technology."},"summary_meta":{"generated_at":"2026-10-26T12:44:15+00:00","model":"gemini-3.5-flash-lite","source_basis":"text+summary","source_urls":["https://www.congress.gov/119/bills/hr8730/BILLS-119hr8730ih.htm"]},"summary_threshold":50,"title":"Connected Vehicle Security Act of 2026","viability":41.7,"viability_detail":{"breakdown":[{"available":true,"effective_weight":35.0,"inputs":[{"label":"Detected stage","value":"Referred to committee"}],"key":"stage","label":"Legislative stage","note":"Stage value from the table on the About page.","points":7.0,"value":0.2,"weight":35},{"available":true,"effective_weight":15.0,"inputs":[{"label":"Committee activity","value":"Referred to committee"}],"key":"committee","label":"Committee activity","note":"","points":3.0,"value":0.2,"weight":15},{"available":true,"effective_weight":15.0,"inputs":[{"label":"Floor activity","value":"Considered on the floor (rule, motion, cloture, vote)"}],"key":"floor","label":"Floor consideration","note":"","points":10.5,"value":0.7,"weight":15},{"available":true,"effective_weight":15.0,"inputs":[{"label":"Days since latest action","value":168},{"label":"Half-life (days)","value":90}],"key":"momentum","label":"Recent action","note":"","points":4.11,"value":0.2742,"weight":15},{"available":true,"effective_weight":10.0,"inputs":[{"label":"Cosponsors","value":144},{"label":"House majority","value":218}],"key":"cosponsors","label":"Cosponsorship","note":"","points":8.13,"value":0.8127,"weight":10},{"available":true,"effective_weight":10.0,"inputs":[{"label":"Democratic supporters","value":65},{"label":"Republican supporters","value":80}],"key":"bipartisan","label":"Bipartisan support","note":"Sponsor plus cosponsors; independents are not counted toward either party.","points":8.97,"value":0.8966,"weight":10}],"data_completeness":1.0,"formula_version":"1.1","reached_stage":"in_committee","score":41.7,"stage":"i